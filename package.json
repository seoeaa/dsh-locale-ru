{
  "name": "@dsh-local/locale-ru",
  "version": "0.2.0",
  "description": "Russian interface for DeepSeek Harness (client locale plugin)",
  "type": "module",
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./dsh/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "check": "node scripts/check-coverage.mjs",
    "test": "node scripts/verify.mjs && node scripts/check-coverage.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seoeaa/dsh-locale-ru.git"
  },
  "bugs": {
    "url": "https://github.com/seoeaa/dsh-locale-ru/issues"
  },
  "homepage": "https://github.com/seoeaa/dsh-locale-ru#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "locale",
    "russian",
    "i18n",
    "translation"
  ]
}
